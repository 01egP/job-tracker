# Single root .env, read by both docker compose and apps/api.
# Copy it: cp .env.example .env

# --- MySQL (docker compose) ---
MYSQL_ROOT_PASSWORD=root

# --- API database connection ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=job_tracker
DB_PASSWORD=job_tracker
DB_NAME=job_tracker

# --- API ---
API_PORT=3000
JWT_SECRET=change-me-to-a-long-random-string
